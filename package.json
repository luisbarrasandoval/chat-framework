{
  "name": "chat-framework",
  "version": "1.0.0",
  "description": "Industry-agnostic LLM-guided state machine & Server-Driven UI (SDUI) chat framework",
  "author": "Luis Francisco Barra Sandoval",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "keywords": [
    "chatbot",
    "conversational-ai",
    "llm",
    "state-machine",
    "fsm",
    "finite-state-machine",
    "server-driven-ui",
    "sdui",
    "tool-calling",
    "function-calling",
    "openai",
    "zod",
    "typescript"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs');for(const d of ['dist','dist-examples'])fs.rmSync(d,{recursive:true,force:true})\"",
    "build": "tsc",
    "test": "npm run clean && npm run build && tsc -p tsconfig.examples.json && node dist-examples/examples/clinic/verify.js",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "openai": "^4.86.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "typescript": "^5.7.3"
  }
}
